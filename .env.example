DB_HOST=localhost
DB_USER=admin
DB_PASSWORD=secret
DB_NAME=facilitador_de_doacoes
DB_PORT=5432
DB_SSLMODE=disable

PORT=8080
FRONTEND_URL=http://localhost:5173

# ASAAS payment gateway
ASAAS_API_KEY=seu_token_aqui
ASAAS_SANDBOX=true
ASAAS_WEBHOOK_TOKEN=seu_token_aqui

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=your_service_role_key
SUPABASE_BUCKET_NAME=faz-a-boa

# Auth0 (JWT validation)
AUTH0_DOMAIN=seu-tenant.auth0.com
AUTH0_AUDIENCE=https://auth-facilitador-de-doacoes.com

# Auth0 Management API (Machine-to-Machine app com permissão update:users)
AUTH0_MGMT_CLIENT_ID=seu_mgmt_client_id
AUTH0_MGMT_CLIENT_SECRET=seu_mgmt_client_secret

# Redis - Asynq queue
REDIS_URL=redis://blablalbalba